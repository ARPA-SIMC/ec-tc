! Version with minimal surface fields (to be used with ICON-EU surface analysis ie. init_mode = 3)
&remap_nml
 in_grid_filename  = "@IN_GRID@"
 in_filename       = "@IN_FILE@"
 in_type           = 3
 out_grid_filename = "@MODEL_GRID@"
 out_filename      = "@OUT_FILE@"
 out_type          = 2
 out_filetype      = 4
 l_have3dbuffer    = .false.
 ncstorage_file    = "@MODEL_NCSTORE@"
/
&input_field_nml  ! horiz. wind comp. u
 inputname      = "U"
 outputname     = "U"
 intp_method = 3
/
&input_field_nml  ! horiz. wind comp. v
 inputname      = "V"
 outputname     = "V"
 intp_method = 3
/
&input_field_nml  ! vertical velocity
 inputname      = "OMEGA"
 outputname     = "W"
 intp_method = 3
/
&input_field_nml  ! temperature
 inputname      = "T"
 outputname     = "T"
 intp_method = 3
/
&input_field_nml  ! specific humidity
 inputname      = "QV"
 outputname     = "QV"
 intp_method = 3
/
&input_field_nml  ! cloud liquid water content
 inputname      = "CLWC"
 outputname     = "QC"
 intp_method = 3
/
&input_field_nml  ! cloud ice content
 inputname      = "CIWC"
 outputname     = "QI"
 intp_method = 3
/
&input_field_nml  ! rain water content
 inputname      = "CRWC"
 outputname     = "QR"
 intp_method = 3
/
&input_field_nml  ! snow water content
 inputname      = "CSWC"
 outputname     = "QS"
 intp_method = 3
/
&input_field_nml  ! surface pressure
 inputname      = "LNSP"
 outputname     = "LNPS" 
 intp_method = 3
/
&input_field_nml  ! geopotential
 inputname      = "FI"
 outputname     = "GEOP_ML" 
 intp_method = 3
 loptional      = .TRUE.
/
!
! Surface and soil parameters (grib2 or grib1)
!
&input_field_nml  ! geopotential
 inputname      = "FIS"
 outputname     = "GEOP_SFC" 
 intp_method = 3  
! inputname      = "Z"
! code           = 129
/
&input_field_nml  ! sea surface temperature
 inputname      = "SST"
 outputname     = "SST" 
 intp_method = 3
! code           = 34
/
&input_field_nml  ! sea-ice cover
 inputname      = "CI"
 outputname     = "CI" 
 intp_method = 3
! inputname      = "CI"
! code           = 31
/
&input_field_nml  ! Land/sea mask
 inputname      = "LSM"
 outputname     = "LSM" 
 intp_method = 3
! code           = 172 
/
