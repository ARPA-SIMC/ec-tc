%include <sched_prolog.h>
%include <sched_serial_long.h>
%include <script_prolog_ver.h>
#
# Retieve all Carmens observations availble for one day of LEPS verification
# Process 24 hourly timestapms, from 00 to 21 of the required day (Carmens data are 3-hourly)
#

set -x

echo "In v_get_obs_carm"
ECTC_ARC=%ECTC_ARC%
ECTC_WORK=%ECTC_WORK%

mode=%mode%
if [ $mode = "cron" ] ; then
  YMD=$(ecflow_client --query meter /ileps_ver_2.5km/day/v_start:YMDc)
elif [ $mode = "free" ] ; then
  echo "stride "$stride" block "$block
  YMD0=%YMDf%
  YMD=$(date -ud "${YMD0} + ${block}day" +%%Y%%m%%d )
fi
echo "Processing verification times for day: "$YMD
echo "ECTC_ARC "$ECTC_ARC

run_dir=$ECTC_WORK/bufr.${block}
mkdir -p $run_dir
cd $run_dir
rm -f obs_??Z-*.nc

# Retrieve Carmens archive for the current date
ncftpget -u icon -p '!2022@ico' ftp://193.26.129.30/OBS_NC/obs_nc_${YMD}.tar.gz
tar -xzf obs_nc_${YMD}.tar.gz
rm -f obs_nc_${YMD}.tar.gz

# Create links to NetCDF files (they will be further linked to "input" dir by v_mec.ecf)
for hh in $(seq -f "%%02g" 0 3 21) ; do
  for file in $(ls OBS_CONVERT/${YMD}${hh}_AED/obs*.nc) ; do  
    bfile=$(basename $file)
    id=$(echo $bfile | cut -d - -f 2-4 | cut -d . -f 1)
    ofile="obs_${hh}Z-${id}.nc"
    ln -sf $file $ofile
  done
done

%include <tail.h>

